{
  "name": "@speak2split/api",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --env-file=../../.env --respawn --transpile-only src/main.ts",
    "start:dev": "ts-node-dev --env-file=../../.env --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/apps/api/src', {recursive: true}); fs.writeFileSync('dist/apps/api/src/main.js', 'require(\\\"../../../main.js\\\");');\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@speak2split/shared": "0.1.0",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.17.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
