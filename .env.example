# Speak2Split — Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.

# ---------- Database ----------
# Local MongoDB (run `mongod --dbpath ./data`), or a MongoDB Atlas connection string.
# NOTE: multi-document transactions (used when creating a group + its owner
# membership) require MongoDB to be running as a replica set — Atlas does
# this by default; a local standalone mongod needs a one-time
# `rs.initiate()` after starting with `--replSet rs0`. See ARCHITECTURE.md.
MONGODB_URI="mongodb://localhost:27017/speak2split"

# ---------- Auth ----------
# If using Clerk (recommended for fastest path to production-grade auth):
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""
# If rolling custom email/password + OAuth instead of Clerk:
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_SIGN_IN_CLIENT_ID=""
APPLE_SIGN_IN_TEAM_ID=""
APPLE_SIGN_IN_KEY_ID=""
APPLE_SIGN_IN_PRIVATE_KEY=""

# ---------- AI service layer (apps/api/src/services/ai) ----------
# Every AI call goes through one server-side layer. Keys stay on the server —
# never put them in the app or in EXPO_PUBLIC_* variables.
#
# Provider per function + comma-separated fallbacks (tried on error/timeout;
# providers without a key are skipped; an empty FALLBACK means "no fallback").
# Leave these unset to use the defaults shown (same order as before).
AI_TRANSCRIBE_PROVIDER=""    # default assemblyai   | assemblyai, groq, gemini, openai, google_speech
AI_TRANSCRIBE_FALLBACK=""    # default groq,gemini
AI_PARSE_PROVIDER=""         # default gemini       | gemini, groq, openai, deepseek
AI_PARSE_FALLBACK=""         # default groq,openai,deepseek
AI_RECEIPT_PROVIDER=""       # default google_vision | google_vision, gemini, openai
AI_RECEIPT_FALLBACK=""       # default gemini,openai
# Optional per-attempt timeouts (ms)
AI_TRANSCRIBE_TIMEOUT_MS=""  # default 30000 (AssemblyAI uses ASSEMBLYAI_MAX_WAIT_MS)
AI_PARSE_TIMEOUT_MS=""       # default 15000
AI_RECEIPT_TIMEOUT_MS=""     # default 30000
# Models
AI_GEMINI_MODEL=""           # default gemini-3.5-flash-lite (expense parsing + receipts)
AI_GEMINI_TRANSCRIBE_MODEL="" # default gemini-2.5-flash. Google no longer offers 2.5 Flash to new
                             # projects and reroutes it from Dec 1 2026 — set "gemini-3.5-flash-lite".
#
# FREE TIER ONLY: use accounts with NO card / NO auto-pay / NO billing enabled.
# OpenAI, DeepSeek, Google Vision and Google Speech are paid services: they are
# only used if their key is set. See README "AI service layer".
ASSEMBLYAI_API_KEY=""        # speech-to-text (primary) — AssemblyAI free-tier account
ASSEMBLYAI_ENABLED=""        # "false" switches AssemblyAI off without removing the key
ASSEMBLYAI_MAX_WAIT_MS=""    # default 45000 (max wait for a transcript before falling back)
GROQ_API_KEY=""              # speech-to-text + expense parsing (free plan)
GEMINI_API_KEY=""            # speech-to-text, expense parsing, receipts (AI Studio key, project WITHOUT billing)
OPENAI_API_KEY=""            # optional, paid
DEEPSEEK_API_KEY=""          # optional, paid
GOOGLE_VISION_API_KEY=""     # optional, paid (receipt OCR)
GOOGLE_SPEECH_API_KEY=""     # optional, paid (speech-to-text, only if chosen explicitly)
#
# Deprecated names (still read for one release, with a warning in the logs):
#   STT_PROVIDER -> AI_TRANSCRIBE_PROVIDER, OCR_PROVIDER -> AI_RECEIPT_PROVIDER,
#   GEMINI_MODEL -> AI_GEMINI_MODEL, GEMINI_STT_MODEL -> AI_GEMINI_TRANSCRIBE_MODEL,
#   GROQ_KEY -> GROQ_API_KEY, GOOGLE_API_KEY -> GEMINI_API_KEY / GOOGLE_VISION_API_KEY.
# Removed: ANTHROPIC_API_KEY, EXPENSE_PARSER_MODEL (Anthropic is no longer a provider).

# ---------- File Storage (receipts, attachments, documents, avatars) ----------
STORAGE_PROVIDER="s3" # s3 | gcs | supabase
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# ---------- Push Notifications ----------
EXPO_ACCESS_TOKEN="" # for Expo Push Notification service

# ---------- Transactional Email ----------
EMAIL_PROVIDER="resend" # resend | sendgrid | postmark
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@speak2split.app"

# ---------- WhatsApp (official WhatsApp Business Cloud API only) ----------
# Requires a Meta Business account + approved message templates. Do NOT
# attempt to automate a personal WhatsApp account — this integration only
# supports the official Cloud API with explicit user opt-in.
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ---------- Real-time ----------
WEBSOCKET_PORT="4001"
REDIS_URL="redis://localhost:6379" # used for WS pub/sub across horizontally scaled API instances

# ---------- Analytics & Monitoring ----------
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"
SENTRY_DSN=""

# ---------- App / API ----------
API_PORT="3000"
API_BASE_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:8081"
NODE_ENV="development"

# ---------- Mobile (apps/mobile/.env — Expo public vars must be prefixed EXPO_PUBLIC_) ----------
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
EXPO_PUBLIC_WEBSOCKET_URL="ws://localhost:4001"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""
EXPO_PUBLIC_POSTHOG_API_KEY=""
EXPO_PUBLIC_SENTRY_DSN=""

# Google Sign-In (mobile side). Create OAuth 2.0 credentials in Google Cloud
# Console (console.cloud.google.com > APIs & Services > Credentials).
# WEB client ID is required even for a mobile app — expo-auth-session uses
# it for the token exchange on every platform per Google's own guidance.
# The backend's GOOGLE_OAUTH_CLIENT_ID (see above) MUST be set to this same
# Web client ID, since that's the audience the server verifies tokens against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""       # optional — only if using the iOS-native redirect
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""   # optional — only if using the Android-native redirect
# In Expo Go, the OAuth redirect goes through Expo's hosted proxy
# (auth.expo.io) — add that proxy's redirect URI (shown in the Expo docs /
# printed by expo-auth-session in dev) to the Web client's "Authorized
# redirect URIs" in Google Cloud Console. In a standalone/dev-client build,
# no proxy is needed — the app's own `scheme` (see app.json) is used instead.

# Apple Sign-In (mobile side) requires no separate mobile env var — it uses
# the app's bundleIdentifier (see app.json) and an Apple Developer account
# with "Sign In with Apple" capability enabled for that App ID. The backend
# APPLE_SIGN_IN_CLIENT_ID (see above) must match that bundle identifier.
# Only available on iOS; the login screen hides the button on Android since
# Apple does not offer this capability there.
