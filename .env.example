# Speak2Split — Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.

# ---------- Database ----------
# Local MongoDB (run `mongod --dbpath ./data`), or a MongoDB Atlas connection string.
# NOTE: multi-document transactions (used when creating a group + its owner
# membership) require MongoDB to be running as a replica set — Atlas does
# this by default; a local standalone mongod needs a one-time
# `rs.initiate()` after starting with `--replSet rs0`. See ARCHITECTURE.md.
MONGODB_URI="mongodb://localhost:27017/speak2split"

# ---------- Auth ----------
# If using Clerk (recommended for fastest path to production-grade auth):
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""
# If rolling custom email/password + OAuth instead of Clerk:
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_SIGN_IN_CLIENT_ID=""
APPLE_SIGN_IN_TEAM_ID=""
APPLE_SIGN_IN_KEY_ID=""
APPLE_SIGN_IN_PRIVATE_KEY=""

# ---------- AI / NLP Expense Parsing ----------
ANTHROPIC_API_KEY=""
EXPENSE_PARSER_MODEL="claude-sonnet-4-6"

# ---------- Speech-to-Text (voice pipeline) ----------
# Requires a dev build (not Expo Go) for on-device mic capture with
# expo-av / expo-audio. Choose ONE STT provider:
STT_PROVIDER="whisper" # whisper | google | deepgram
OPENAI_API_KEY=""          # if STT_PROVIDER=whisper via OpenAI's Whisper API
GOOGLE_SPEECH_API_KEY=""   # if STT_PROVIDER=google
DEEPGRAM_API_KEY=""        # if STT_PROVIDER=deepgram

# ---------- Receipt OCR ----------
OCR_PROVIDER="google_vision" # google_vision | textract | tesseract_local
GOOGLE_VISION_API_KEY=""
AWS_TEXTRACT_ACCESS_KEY_ID=""
AWS_TEXTRACT_SECRET_ACCESS_KEY=""
AWS_REGION=""

# ---------- File Storage (receipts, attachments, documents, avatars) ----------
STORAGE_PROVIDER="s3" # s3 | gcs | supabase
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# ---------- Push Notifications ----------
EXPO_ACCESS_TOKEN="" # for Expo Push Notification service

# ---------- Transactional Email ----------
EMAIL_PROVIDER="resend" # resend | sendgrid | postmark
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@speak2split.app"

# ---------- WhatsApp (official WhatsApp Business Cloud API only) ----------
# Requires a Meta Business account + approved message templates. Do NOT
# attempt to automate a personal WhatsApp account — this integration only
# supports the official Cloud API with explicit user opt-in.
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ---------- Real-time ----------
WEBSOCKET_PORT="4001"
REDIS_URL="redis://localhost:6379" # used for WS pub/sub across horizontally scaled API instances

# ---------- Analytics & Monitoring ----------
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"
SENTRY_DSN=""

# ---------- App / API ----------
API_PORT="3000"
API_BASE_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:8081"
NODE_ENV="development"

# ---------- Mobile (apps/mobile/.env — Expo public vars must be prefixed EXPO_PUBLIC_) ----------
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
EXPO_PUBLIC_WEBSOCKET_URL="ws://localhost:4001"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""
EXPO_PUBLIC_POSTHOG_API_KEY=""
EXPO_PUBLIC_SENTRY_DSN=""

# Google Sign-In (mobile side). Create OAuth 2.0 credentials in Google Cloud
# Console (console.cloud.google.com > APIs & Services > Credentials).
# WEB client ID is required even for a mobile app — expo-auth-session uses
# it for the token exchange on every platform per Google's own guidance.
# The backend's GOOGLE_OAUTH_CLIENT_ID (see above) MUST be set to this same
# Web client ID, since that's the audience the server verifies tokens against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""       # optional — only if using the iOS-native redirect
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""   # optional — only if using the Android-native redirect
# In Expo Go, the OAuth redirect goes through Expo's hosted proxy
# (auth.expo.io) — add that proxy's redirect URI (shown in the Expo docs /
# printed by expo-auth-session in dev) to the Web client's "Authorized
# redirect URIs" in Google Cloud Console. In a standalone/dev-client build,
# no proxy is needed — the app's own `scheme` (see app.json) is used instead.

# Apple Sign-In (mobile side) requires no separate mobile env var — it uses
# the app's bundleIdentifier (see app.json) and an Apple Developer account
# with "Sign In with Apple" capability enabled for that App ID. The backend
# APPLE_SIGN_IN_CLIENT_ID (see above) must match that bundle identifier.
# Only available on iOS; the login screen hides the button on Android since
# Apple does not offer this capability there.
